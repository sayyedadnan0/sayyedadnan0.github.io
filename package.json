{
  "name": "adnan-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node scripts/generate-clients.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/generate-clients.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:seed:portfolio": "ts-node --project prisma/tsconfig.json prisma/seed-portfolio.ts",
    "deploy:start": "node scripts/deploy/start.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:media": "node scripts/deploy/seed-media.mjs",
    "test:deployment": "node scripts/deploy/verify-persistence.mjs",
    "build:netlify": "node scripts/deploy/netlify-build.mjs",
    "build:pages": "node scripts/deploy/build-pages.mjs"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/supabase-js": "2.119.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.56.0",
    "next": "16.4.6",
    "prisma": "^5.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
