# Copy to .env. Real .env files must stay outside Git.
DATABASE_URL="file:./dev.db"

# Required when creating your first local CMS account (12+ character password).
# Existing accounts are not overwritten by db:seed.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
JWT_SECRET=""

# Set the real HTTPS origin before deploying; never use an unowned domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Enable indexing only after the public site is ready. Localhost remains noindex.
SITE_INDEXABLE="false"

MAX_FILE_SIZE="50000000"
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW="3600000"
# Local uploads default to public/uploads. On Render these are set by render.yaml:
# PORTFOLIO_DATA_DIR="/var/data"
# UPLOAD_DIR="/var/data/uploads"
# DATABASE_URL="file:/var/data/portfolio.db"
# Render supplies RENDER_EXTERNAL_URL when NEXT_PUBLIC_SITE_URL is not set.
# S3 and automatic email notifications are not implemented.

# Free hosting: set privately in Netlify, not in Git or browser code.
# DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
# DIRECT_URL="postgresql://...:5432/postgres?schema=public"
# STORAGE_PROVIDER="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="portfolio-media"
